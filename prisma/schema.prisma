// Part 1 (Auth + Todos) + Part 2 (TodoCollaborator) + Part 3 (deadlines &
// notifications) schema. See docs/BACKEND_DEVELOPMENT_PLAN.md §5.2/§6.2/§7.2
// for the full plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  todos              Todo[]                   @relation("OwnedTodos")
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  collaboratingOn    TodoCollaborator[]
  notifications      Notification[]
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Todo {
  id             Int       @id @default(autoincrement())
  title          String
  completed      Boolean   @default(false)
  ownerId        Int
  owner          User      @relation("OwnedTodos", fields: [ownerId], references: [id], onDelete: Cascade)
  deadline       DateTime?
  reminderSentAt DateTime? // set once the pre-deadline reminder has fired, to avoid duplicates
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collaborators TodoCollaborator[]
  notifications Notification[]

  @@index([ownerId])
}

model TodoCollaborator {
  id        Int      @id @default(autoincrement())
  todoId    Int
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy Int
  createdAt DateTime @default(now())

  @@unique([todoId, userId])
  @@index([userId])
}

enum NotificationType {
  DEADLINE_REMINDER
  COLLABORATOR_INVITED
  TASK_UPDATED
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int // recipient
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  todoId    Int?
  todo      Todo?            @relation(fields: [todoId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([todoId])
}
